{
  "name": "sigma-gravity-research-simulator",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "description": "Public, reproducible preview API for galaxy and gravity-formula tests.",
  "scripts": {
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:resolved-evidence": "python scripts/export-resolved-twin-evidence.py",
    "build": "node scripts/build-static.mjs && node scripts/verify-build.mjs",
    "audit:twins": "node scripts/audit-heldout-twins.mjs",
    "dev": "node scripts/dev-server.mjs",
    "worker": "node scripts/worker-server.mjs",
    "dev:vercel": "vercel dev",
    "smoke": "node scripts/smoke-http.mjs",
    "smoke:blob": "node --env-file-if-exists=.env.local scripts/smoke-private-blob.mjs",
    "smoke:queue": "node scripts/smoke-queue-canary.mjs",
    "migrate:production-db": "node --env-file-if-exists=.env.local scripts/migrate-production-database.mjs",
    "smoke:field-jobs": "python ../scripts/smoke_local_field_job_api.py",
    "smoke:two-potential": "python ../scripts/smoke_local_two_potential_api.py",
    "smoke:observation-jobs": "python ../scripts/smoke_local_observation_evaluation_api.py",
    "smoke:galaxy-jobs": "python ../scripts/smoke_local_galaxy_job_api.py",
    "smoke:inverse-response": "python ../scripts/smoke_local_inverse_response_api.py",
    "smoke:batches": "python ../scripts/smoke_local_batch_api.py",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/queue": "^0.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4"
  }
}
