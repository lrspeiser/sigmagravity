{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigma-gravity-research-simulator-five.vercel.app/schemas/advanced-plugin-v1.schema.json",
  "title": "Sigma signed advanced plug-in manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "version", "description", "publisher", "runtime", "isolation", "entrypoint", "files", "resources", "interface", "packageSha256", "signature"],
  "properties": {
    "schemaVersion": { "const": "sigma-advanced-plugin/1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "description": { "type": "string", "maxLength": 1000 },
    "publisher": { "$ref": "#/$defs/publisher" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "isolation": { "$ref": "#/$defs/isolation" },
    "entrypoint": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}\\.py$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,154}\\.(?:py|json)$" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallTimeSeconds", "cpuSeconds", "cpuCores", "memoryMiB", "pids", "stdoutBytes", "stderrBytes", "temporaryBytes"],
      "properties": {
        "wallTimeSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "cpuSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "cpuCores": { "type": "number", "minimum": 0.25, "maximum": 2 },
        "memoryMiB": { "type": "integer", "minimum": 64, "maximum": 2048 },
        "pids": { "type": "integer", "minimum": 4, "maximum": 128 },
        "stdoutBytes": { "type": "integer", "minimum": 1024, "maximum": 8388608 },
        "stderrBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "temporaryBytes": { "type": "integer", "minimum": 1048576, "maximum": 67108864 }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSchemaVersion", "outputSchemaVersion"],
      "properties": {
        "inputSchemaVersion": { "const": "sigma-advanced-plugin-input/1" },
        "outputSchemaVersion": { "const": "sigma-advanced-plugin-output/1" }
      }
    },
    "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "valueBase64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "pattern": "^ed25519_[0-9a-f]{24}$" },
        "valueBase64": { "type": "string", "minLength": 88, "maxLength": 88 }
      }
    }
  },
  "$defs": {
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "pattern": "^ed25519_[0-9a-f]{24}$" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pythonVersion", "packages"],
      "properties": {
        "id": { "const": "sigma-python-plugin/1" },
        "pythonVersion": { "const": "3.13.7" },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numpy", "scipy"],
          "properties": { "numpy": { "const": "2.2.6" }, "scipy": { "const": "1.16.1" } }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "network", "rootFilesystem", "pluginMount", "datasetMount", "credentials"],
      "properties": {
        "execution": { "const": "single_use_container" },
        "network": { "const": "none" },
        "rootFilesystem": { "const": "read_only" },
        "pluginMount": { "const": "read_only" },
        "datasetMount": { "const": "read_only" },
        "credentials": { "const": "none" }
      }
    }
  }
}
