{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigmagravity.org/schemas/inverse-response-job-submit-v1.schema.json",
  "title": "Sigma inverse baryon-to-response discovery job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataUploadId", "systems", "kernel", "outputLicense"],
  "properties": {
    "schemaVersion": { "const": "sigma-inverse-response-job-submit/1" },
    "dataUploadId": { "type": "string", "pattern": "^upload_[0-9a-f]{24}$" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceKey", "targetKey", "uncertaintyKey"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "sourceKey": { "type": "string", "minLength": 1 },
          "targetKey": { "type": "string", "minLength": 1 },
          "uncertaintyKey": { "type": "string", "minLength": 1 },
          "maskKey": { "type": "string", "minLength": 1 }
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "integer", "minimum": 3 } },
        "ridge": { "type": "number", "minimum": 0 },
        "smoothness": { "type": "number", "minimum": 0 },
        "nonnegative": { "type": "boolean" },
        "regularizationMultipliers": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ensembleSize": { "type": "integer", "minimum": 20, "maximum": 512 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "nullControls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "source_radial_angle_shuffle" },
        "count": { "type": "integer", "minimum": 19, "maximum": 999 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "outputLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "redistributionAllowed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "redistributionAllowed": { "type": "boolean" }
      }
    }
  }
}
