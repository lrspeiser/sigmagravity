{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigmagravity.org/schemas/batch-submit-v1.schema.json",
  "title": "Sigma multi-system field batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "model", "systems", "fieldRequest", "parameterPolicy"],
  "properties": {
    "schemaVersion": { "const": "sigma-batch-submit/1" },
    "model": { "type": "object" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "dataUploadId": { "type": "string", "pattern": "^upload_[0-9a-f]{24}$" },
          "observationDataUploadId": { "type": "string", "pattern": "^upload_[0-9a-f]{24}$" },
          "galaxyJobId": { "type": "string", "pattern": "^job_[0-9a-f]{24}$" },
          "galaxyArtifact": {
            "enum": [
              "field_surface_density",
              "field_volume_density",
              "surface_density_ensemble",
              "volume_density_ensemble"
            ]
          },
          "ensembleSelection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surfaceRealizations"],
            "properties": {
              "surfaceRealizations": {
                "oneOf": [
                  { "const": "all" },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": { "type": "integer", "minimum": 0, "maximum": 15 }
                  }
                ]
              },
              "verticalRealizations": {
                "oneOf": [
                  { "const": "all" },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": { "type": "integer", "minimum": 0, "maximum": 7 }
                  }
                ]
              },
              "maximumChildren": { "type": "integer", "minimum": 1, "maximum": 128, "default": 128 }
            }
          },
          "observationTargets": {
            "type": "array",
            "maxItems": 32,
            "items": { "$ref": "observation-target-v1.schema.json" }
          }
        },
        "oneOf": [
          {
            "required": ["dataUploadId"],
            "not": { "anyOf": [{ "required": ["galaxyJobId"] }, { "required": ["ensembleSelection"] }] }
          },
          {
            "required": ["galaxyJobId", "galaxyArtifact"],
            "properties": {
              "galaxyArtifact": { "enum": ["field_surface_density", "field_volume_density"] }
            },
            "not": { "anyOf": [{ "required": ["dataUploadId"] }, { "required": ["ensembleSelection"] }] }
          },
          {
            "required": ["galaxyJobId", "galaxyArtifact", "ensembleSelection"],
            "properties": {
              "galaxyArtifact": { "enum": ["surface_density_ensemble", "volume_density_ensemble"] }
            },
            "not": { "required": ["dataUploadId"] }
          }
        ]
      }
    },
    "fieldRequest": { "type": "object" },
    "parameterPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "perObjectParameters"],
      "properties": {
        "mode": {
          "enum": ["published_fixed", "universal_fixed", "universal_fit", "train_validation_holdout", "hierarchical", "per_object"]
        },
        "perObjectParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "populationParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "splits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "holdout"],
          "properties": {
            "train": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "holdout": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
