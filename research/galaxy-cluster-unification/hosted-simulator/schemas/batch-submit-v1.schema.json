{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigmagravity.org/schemas/batch-submit-v1.schema.json",
  "title": "Sigma multi-system field batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "model", "systems", "fieldRequest", "parameterPolicy"],
  "properties": {
    "schemaVersion": { "const": "sigma-batch-submit/1" },
    "model": { "type": "object" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "dataUploadId": { "type": "string", "pattern": "^upload_[0-9a-f]{24}$" },
          "observationDataUploadId": { "type": "string", "pattern": "^upload_[0-9a-f]{24}$" },
          "galaxyJobId": { "type": "string", "pattern": "^job_[0-9a-f]{24}$" },
          "galaxyArtifact": { "enum": ["field_surface_density", "field_volume_density"] },
          "observationTargets": {
            "type": "array",
            "maxItems": 32,
            "items": { "$ref": "observation-target-v1.schema.json" }
          }
        },
        "oneOf": [
          { "required": ["dataUploadId"], "not": { "required": ["galaxyJobId"] } },
          { "required": ["galaxyJobId", "galaxyArtifact"], "not": { "required": ["dataUploadId"] } }
        ]
      }
    },
    "fieldRequest": { "type": "object" },
    "parameterPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "perObjectParameters"],
      "properties": {
        "mode": {
          "enum": ["published_fixed", "universal_fixed", "universal_fit", "train_validation_holdout", "hierarchical", "per_object"]
        },
        "perObjectParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "populationParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "splits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "holdout"],
          "properties": {
            "train": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "holdout": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
