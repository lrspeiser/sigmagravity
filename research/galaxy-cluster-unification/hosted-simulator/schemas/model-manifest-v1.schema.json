{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigma-gravity-research-simulator-five.vercel.app/schemas/model-manifest-v1.schema.json",
  "title": "Sigma field model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "modelClass",
    "source",
    "geometry",
    "fields",
    "parameters",
    "equations",
    "observables",
    "dataRequirements",
    "solver",
    "parameterPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "sigma-field-model/1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "modelClass": { "enum": ["stationary_elliptic", "algebraic", "nonlocal_stationary"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "text", "confirmedCanonical"],
      "properties": {
        "format": { "enum": ["latex", "plain_text", "json_ast"] },
        "text": { "type": "string", "minLength": 1 },
        "confirmedCanonical": { "type": "boolean" },
        "confirmedModelSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exact computational model hash returned by validation and explicitly accepted by the researcher. Required for execution when confirmedCanonical is true."
        },
        "citation": { "type": "string", "format": "uri" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSystem", "dimensions", "domain"],
      "properties": {
        "coordinateSystem": { "enum": ["cartesian_2d", "cartesian_3d", "axisymmetric_cylindrical"] },
        "dimensions": { "enum": [2, 3] },
        "domain": {
          "type": "object",
          "required": ["lengthUnit"],
          "properties": {
            "lengthUnit": { "const": "m" },
            "boundaryExtent": { "type": "string" }
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "parameters": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/equation" }
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observable" }
    },
    "dataRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataRequirement" }
    },
    "solver": { "$ref": "#/$defs/solver" },
    "parameterPolicy": { "$ref": "#/$defs/parameterPolicy" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
    "unit": {
      "enum": [
        "1",
        "dimensionless",
        "kg",
        "m",
        "s",
        "1/m",
        "1/m^2",
        "1/m^3",
        "1/s^2",
        "m/s",
        "m/s^2",
        "m^2/s^2",
        "kg/m^2",
        "kg/m^3",
        "m^3/(kg*s^2)"
      ]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["dirichlet", "neumann", "periodic", "isolated", "mixed"] },
        "value": { "type": "number" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "role", "unit"],
      "properties": {
        "rank": { "enum": ["scalar", "vector", "tensor2"] },
        "role": { "enum": ["source", "solved", "derived"] },
        "unit": { "$ref": "#/$defs/unit" },
        "datasetKey": { "$ref": "#/$defs/name" },
        "boundary": { "$ref": "#/$defs/boundary" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "scope"],
      "properties": {
        "unit": { "$ref": "#/$defs/unit" },
        "scope": { "enum": ["universal", "per_object"] },
        "value": { "type": "number" },
        "initial": { "type": "number" },
        "bounds": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false
        }
      },
      "anyOf": [{ "required": ["value"] }, { "required": ["initial"] }]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["const"],
          "properties": {
            "const": { "type": "number" },
            "unit": { "$ref": "#/$defs/unit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": { "field": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter"],
          "properties": { "parameter": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": [
                "add", "subtract", "min", "max", "multiply", "multiply_zero_vector_limit", "divide",
                "negate", "norm", "gradient", "divergence", "laplacian", "curl",
                "dot", "outer", "trace", "pow", "sqrt", "exp", "log", "tanh",
                "smoothstep", "lt", "lte", "gt", "gte", "line_of_sight_integral",
                "convolution"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "branches", "otherwise"],
          "properties": {
            "op": { "const": "piecewise" },
            "branches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "value"],
                "properties": {
                  "when": { "$ref": "#/$defs/expression" },
                  "value": { "$ref": "#/$defs/expression" }
                }
              }
            },
            "otherwise": { "$ref": "#/$defs/expression" }
          }
        }
      ]
    },
    "equation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "lhs", "rhs"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "const": "equality" },
        "lhs": { "$ref": "#/$defs/expression" },
        "rhs": { "$ref": "#/$defs/expression" }
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "rank", "unit", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "target": { "enum": ["massive_tracers", "photons", "both", "diagnostic"] },
        "rank": { "enum": ["scalar", "vector", "tensor2"] },
        "unit": { "$ref": "#/$defs/unit" },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "dataRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "rank", "unit"],
      "properties": {
        "key": { "$ref": "#/$defs/name" },
        "rank": { "enum": ["scalar", "vector", "tensor2"] },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "relativeTolerance", "maxIterations"],
      "properties": {
        "family": {
          "enum": [
            "algebraic", "fft_poisson", "finite_difference_elliptic",
            "finite_volume_elliptic", "nonlinear_finite_volume",
            "coupled_elliptic", "nonlocal_elliptic"
          ]
        },
        "relativeTolerance": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "residualTolerance": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "maxIterations": { "type": "integer", "minimum": 1 },
        "damping": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "coefficientFloor": { "type": "number", "exclusiveMinimum": 0 },
        "initialization": { "enum": ["zero", "linearized_unit_coefficient"] },
        "nonlinearMethod": { "enum": ["picard", "anderson", "newton_krylov"] },
        "lineSearch": { "enum": ["armijo", "wolfe", "none"] },
        "andersonAlpha": { "type": "number", "exclusiveMinimum": 0 },
        "andersonHistory": { "type": "integer", "minimum": 1, "maximum": 20 },
        "andersonRegularization": { "type": "number", "exclusiveMinimum": 0 },
        "krylovMethod": { "enum": ["lgmres", "gmres", "bicgstab", "cgs", "minres", "tfqmr"] },
        "krylovInnerIterations": { "type": "integer", "minimum": 1, "maximum": 200 },
        "picardWarmupIterations": { "type": "integer", "minimum": 0 },
        "picardWarmupDamping": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "nonlocalBoundary": { "enum": ["zero_padded"] },
        "convolutionMode": { "enum": ["linear_same"] },
        "kernelOrigin": { "enum": ["centered_sample"] },
        "convolutionMeasure": { "enum": ["physical_volume"] }
      }
    },
    "parameterPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "perObjectParameters"],
      "properties": {
        "mode": {
          "enum": [
            "published_fixed", "universal_fixed", "universal_fit",
            "train_validation_holdout", "hierarchical", "per_object"
          ]
        },
        "perObjectParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    }
  }
}
