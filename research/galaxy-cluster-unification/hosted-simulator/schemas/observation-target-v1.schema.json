{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigmagravity.org/schemas/observation-target-v1.schema.json",
  "title": "Sigma observation target v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "observable", "centerM", "provenance", "license"],
  "oneOf": [
    {
      "properties": { "kind": { "const": "circular_speed_curve" } },
      "required": ["radiiM"]
    },
    {
      "properties": { "kind": { "const": "line_of_sight_velocity_field" } },
      "required": ["inclinationDeg", "handedness", "majorCoordinateArrayKey", "minorCoordinateArrayKey"]
    }
  ],
  "properties": {
    "schemaVersion": { "const": "sigma-observation-target/1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["circular_speed_curve", "line_of_sight_velocity_field"] },
    "observable": { "type": "string", "minLength": 1 },
    "gridOriginM": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } },
    "centerM": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } },
    "planeAxes": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 2 } },
    "radiiM": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "observedSpeedsMPerS": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "uncertaintiesMPerS": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "covarianceM2PerS2": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "number" } } },
    "azimuthalSamples": { "type": "integer", "minimum": 16, "maximum": 4096, "default": 128 },
    "minimumAzimuthalCoverage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.8 },
    "fittedNuisanceParameters": { "type": "integer", "minimum": 0, "default": 0 },
    "inclinationDeg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90 },
    "handedness": { "enum": [-1, 1] },
    "majorCoordinateArrayKey": { "type": "string", "minLength": 1 },
    "minorCoordinateArrayKey": { "type": "string", "minLength": 1 },
    "observedVelocityArrayKey": { "type": "string", "minLength": 1 },
    "uncertaintyArrayKey": { "type": "string", "minLength": 1 },
    "observedVelocityZeroPointMPerS": { "type": "number", "default": 0 },
    "intensityWeightArrayKey": { "type": "string", "minLength": 1 },
    "maskArrayKey": { "type": "string", "minLength": 1 },
    "beamKernelArrayKey": { "type": "string", "minLength": 1 },
    "weighting": { "enum": ["inverse_variance", "intensity_inverse_variance"], "default": "inverse_variance" },
    "minimumValidPixels": { "type": "integer", "minimum": 1, "default": 25 },
    "provenance": { "type": "object", "minProperties": 1 },
    "license": {
      "type": "object",
      "required": ["id", "redistributionAllowed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "redistributionAllowed": { "type": "boolean" }
      }
    }
  }
}
