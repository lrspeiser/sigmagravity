{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigmagravity.org/schemas/observation-target-v1.schema.json",
  "title": "Sigma observation target v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "observable", "provenance", "license"],
  "oneOf": [
    {
      "properties": { "kind": { "const": "circular_speed_curve" } },
      "required": ["centerM", "radiiM"]
    },
    {
      "properties": { "kind": { "const": "line_of_sight_velocity_field" } },
      "required": ["centerM", "inclinationDeg", "handedness", "majorCoordinateArrayKey", "minorCoordinateArrayKey"]
    },
    {
      "properties": { "kind": { "const": "photon_lensing_map" } },
      "required": ["northAxis", "eastAxis", "lineOfSightAxis", "distanceRatio", "lensAngularDiameterDistanceM"]
    },
    {
      "properties": { "kind": { "const": "multiple_image_systems" } },
      "required": ["northAxis", "eastAxis", "lineOfSightAxis", "lensAngularDiameterDistanceM", "skyCenterM", "rootSearchBoundArcsec", "families"]
    }
  ],
  "properties": {
    "schemaVersion": { "const": "sigma-observation-target/1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["circular_speed_curve", "line_of_sight_velocity_field", "photon_lensing_map", "multiple_image_systems"] },
    "observable": { "type": "string", "minLength": 1 },
    "gridOriginM": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } },
    "centerM": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } },
    "planeAxes": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 2 } },
    "radiiM": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "observedSpeedsMPerS": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "uncertaintiesMPerS": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "covarianceM2PerS2": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "number" } } },
    "azimuthalSamples": { "type": "integer", "minimum": 16, "maximum": 4096, "default": 128 },
    "minimumAzimuthalCoverage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.8 },
    "fittedNuisanceParameters": { "type": "integer", "minimum": 0, "default": 0 },
    "inclinationDeg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90 },
    "handedness": { "enum": [-1, 1] },
    "nonPositiveInwardPolicy": { "enum": ["exclude", "zero_speed"], "default": "exclude" },
    "majorCoordinateArrayKey": { "type": "string", "minLength": 1 },
    "minorCoordinateArrayKey": { "type": "string", "minLength": 1 },
    "observedVelocityArrayKey": { "type": "string", "minLength": 1 },
    "uncertaintyArrayKey": { "type": "string", "minLength": 1 },
    "observedVelocityZeroPointMPerS": { "type": "number", "default": 0 },
    "intensityWeightArrayKey": { "type": "string", "minLength": 1 },
    "maskArrayKey": { "type": "string", "minLength": 1 },
    "scoreMaskArrayKey": { "type": "string", "minLength": 1 },
    "emissionMaskArrayKey": { "type": "string", "minLength": 1 },
    "beamKernelArrayKey": { "type": "string", "minLength": 1 },
    "weighting": { "enum": ["inverse_variance", "intensity_inverse_variance"], "default": "inverse_variance" },
    "minimumValidPixels": { "type": "integer", "minimum": 1, "default": 25 },
    "northAxis": { "type": "integer", "minimum": 0, "maximum": 2 },
    "eastAxis": { "type": "integer", "minimum": 0, "maximum": 2 },
    "lineOfSightAxis": { "type": "integer", "minimum": 0, "maximum": 2 },
    "distanceRatio": { "type": "number", "exclusiveMinimum": 0 },
    "lensAngularDiameterDistanceM": { "type": "number", "exclusiveMinimum": 0 },
    "skyCenterM": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "rootSearchBoundArcsec": { "type": "number", "exclusiveMinimum": 0 },
    "rootGridPoints": { "type": "integer", "minimum": 21, "maximum": 401, "default": 161 },
    "closureToleranceArcsec": { "type": "number", "exclusiveMinimum": 0, "default": 0.002 },
    "deduplicationToleranceArcsec": { "type": "number", "exclusiveMinimum": 0, "default": 0.2 },
    "jacobianStepArcsec": { "type": "number", "exclusiveMinimum": 0, "default": 0.08 },
    "includeResidualMinima": { "type": "boolean", "default": true },
    "maximumResidualMinimumSeeds": { "type": "integer", "minimum": 1, "maximum": 512, "default": 64 },
    "supplementalGridPoints": { "type": "array", "maxItems": 4, "items": { "type": "integer", "minimum": 21, "maximum": 401 } },
    "includeCriticalCurves": { "type": "boolean", "default": false },
    "criticalCurveGridPoints": { "type": "integer", "minimum": 21, "maximum": 401, "default": 161 },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "distanceRatio", "observedImagesArcsec", "positionUncertaintiesArcsec"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "distanceRatio": { "type": "number", "exclusiveMinimum": 0 },
          "observedImagesArcsec": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          },
          "positionUncertaintiesArcsec": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "observedAlphaEastArcsecArrayKey": { "type": "string", "minLength": 1 },
    "observedAlphaNorthArcsecArrayKey": { "type": "string", "minLength": 1 },
    "deflectionUncertaintyArcsecArrayKey": { "type": "string", "minLength": 1 },
    "observedReducedShear1ArrayKey": { "type": "string", "minLength": 1 },
    "observedReducedShear2ArrayKey": { "type": "string", "minLength": 1 },
    "reducedShearUncertaintyArrayKey": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object", "minProperties": 1 },
    "license": {
      "type": "object",
      "required": ["id", "redistributionAllowed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "redistributionAllowed": { "type": "boolean" }
      }
    }
  }
}
