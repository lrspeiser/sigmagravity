{
  "schemaVersion": "sigma-field-model/1",
  "name": "QUMOND simple interpolation fixture",
  "modelClass": "stationary_elliptic",
  "source": {
    "format": "latex",
    "text": "\\nabla^2\\Phi_N=4\\pi G\\rho_b;\\quad\\nabla^2\\Phi=\\nabla\\cdot[\\nu(|\\nabla\\Phi_N|/a_0)\\nabla\\Phi_N]",
    "confirmedCanonical": true
  },
  "geometry": {
    "coordinateSystem": "cartesian_3d",
    "dimensions": 3,
    "domain": { "lengthUnit": "m", "boundaryExtent": "dataset-derived with convergence padding" }
  },
  "fields": {
    "rho_b": { "rank": "scalar", "role": "source", "unit": "kg/m^3", "datasetKey": "baryon_density" },
    "PhiN": { "rank": "scalar", "role": "solved", "unit": "m^2/s^2", "boundary": { "type": "isolated" } },
    "Phi": { "rank": "scalar", "role": "solved", "unit": "m^2/s^2", "boundary": { "type": "isolated" } }
  },
  "parameters": {
    "G": { "unit": "m^3/(kg*s^2)", "value": 6.6743e-11, "scope": "universal" },
    "a0": { "unit": "m/s^2", "value": 1.2e-10, "scope": "universal" }
  },
  "equations": [
    {
      "id": "newtonian_seed",
      "kind": "equality",
      "lhs": { "op": "laplacian", "args": [{ "field": "PhiN" }] },
      "rhs": { "op": "multiply", "args": [{ "const": 12.566370614359172 }, { "parameter": "G" }, { "field": "rho_b" }] }
    },
    {
      "id": "qumond",
      "kind": "equality",
      "lhs": { "op": "laplacian", "args": [{ "field": "Phi" }] },
      "rhs": {
        "op": "divergence",
        "args": [{
          "op": "multiply",
          "args": [
            {
              "op": "add",
              "args": [
                { "const": 0.5 },
                {
                  "op": "sqrt",
                  "args": [{
                    "op": "add",
                    "args": [
                      { "const": 0.25 },
                      { "op": "divide", "args": [{ "const": 1 }, { "op": "divide", "args": [{ "op": "norm", "args": [{ "op": "gradient", "args": [{ "field": "PhiN" }] }] }, { "parameter": "a0" }] }] }
                    ]
                  }]
                }
              ]
            },
            { "op": "gradient", "args": [{ "field": "PhiN" }] }
          ]
        }]
      }
    }
  ],
  "observables": [{ "id": "massive_tracer_acceleration", "target": "massive_tracers", "rank": "vector", "unit": "m/s^2", "expression": { "op": "negate", "args": [{ "op": "gradient", "args": [{ "field": "Phi" }] }] } }],
  "dataRequirements": [{ "key": "baryon_density", "rank": "scalar", "unit": "kg/m^3" }],
  "solver": { "family": "coupled_elliptic", "relativeTolerance": 1e-8, "maxIterations": 20000 },
  "parameterPolicy": { "mode": "published_fixed", "perObjectParameters": [] }
}
