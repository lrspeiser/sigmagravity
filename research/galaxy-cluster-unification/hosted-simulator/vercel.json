{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/v1/queue-canary-consumer.mjs": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "sigma-control-plane-canary-v1",
          "retryAfterSeconds": 10,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/v1/queue-job-consumer.mjs": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "sigma-control-plane-jobs-v1",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600"}
      ]
    }
  ],
  "rewrites": [
    {"source": "/api/v1/models/:sha256", "destination": "/api/v1/model?sha256=:sha256"},
    {"source": "/api/v1/data-uploads/:id/content", "destination": "/api/v1/data-upload?id=:id&resource=content"},
    {"source": "/api/v1/data-uploads/:id", "destination": "/api/v1/data-upload?id=:id"},
    {"source": "/api/v1/jobs/:id/artifacts/:name", "destination": "/api/v1/job?id=:id&resource=artifact&name=:name"},
    {"source": "/api/v1/jobs/:id/artifacts", "destination": "/api/v1/job?id=:id&resource=artifacts"},
    {"source": "/api/v1/jobs/:id/events", "destination": "/api/v1/job?id=:id&resource=events"},
    {"source": "/api/v1/jobs/:id/cancel", "destination": "/api/v1/job?id=:id&resource=cancel"},
    {"source": "/api/v1/jobs/:id", "destination": "/api/v1/job?id=:id"},
    {"source": "/api/v1/field-jobs/:id/artifacts/:name", "destination": "/api/v1/field-job?id=:id&resource=artifact&name=:name"},
    {"source": "/api/v1/field-jobs/:id/artifacts", "destination": "/api/v1/field-job?id=:id&resource=artifacts"},
    {"source": "/api/v1/field-jobs/:id/events", "destination": "/api/v1/field-job?id=:id&resource=events"},
    {"source": "/api/v1/field-jobs/:id/cancel", "destination": "/api/v1/field-job?id=:id&resource=cancel"},
    {"source": "/api/v1/field-jobs/:id", "destination": "/api/v1/field-job?id=:id"},
    {"source": "/api/v1/galaxy-jobs/:id/artifacts/:name", "destination": "/api/v1/galaxy-job?id=:id&resource=artifact&name=:name"},
    {"source": "/api/v1/galaxy-jobs/:id/artifacts", "destination": "/api/v1/galaxy-job?id=:id&resource=artifacts"},
    {"source": "/api/v1/galaxy-jobs/:id/events", "destination": "/api/v1/galaxy-job?id=:id&resource=events"},
    {"source": "/api/v1/galaxy-jobs/:id/cancel", "destination": "/api/v1/galaxy-job?id=:id&resource=cancel"},
    {"source": "/api/v1/galaxy-jobs/:id", "destination": "/api/v1/galaxy-job?id=:id"},
    {"source": "/api/v1/systems/:id", "destination": "/api/v1/system?id=:id"},
    {"source": "/api/v1/openapi.json", "destination": "/api/v1/spec"}
  ]
}
