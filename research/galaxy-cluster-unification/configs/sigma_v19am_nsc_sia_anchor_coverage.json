    "unified_candidates": "data/derived/sigma_v19aa_member_counterpart_association/unified_candidates.csv",
    "all_measurements": "data/derived/sigma_v19ac_nsc_measurement_photometry/all_measurements.csv"
  },
  "source": {
    "authority": "NSF NOIRLab Astro Data Lab",
    "service": "NSC DR2 Simple Image Access metadata",
    "endpoint": "https://datalab.noirlab.edu/sia/nsc_dr2",
    "query_size_degrees": 0.01,
    "timeout_seconds": 180,
    "exact_match_key": "NSC measurement exposure equals the basename of the SIA siaRef value",
    "required_instrument_name": "DECam",
    "required_proctype": "InstCal",
    "required_prodtype": "image",
    "required_access_format": "image/fits",
    "required_calib_level": 2,
    "retention_rule": "Retain one descriptor for every anchor measurement. Fail on zero or multiple exact exposure matches. Apply no flag, seeing, filter, date, depth, PSF, photometric or validation-performance selection."
  },
  "gates": {
    "exact_anchor_count": 15,
    "exact_development_anchor_count": 10,
    "exact_validation_anchor_count": 5,
    "exact_anchor_measurement_rows": 1032,
    "every_measurement_has_exactly_one_sia_descriptor": true,
    "measurement_and_sia_band_match": true,
    "every_descriptor_is_required_calibrated_decam_image": true,
    "all_measurements_retained_without_quality_or_exposure_selection": true,
    "raw_metadata_payload_and_query_hashed_for_every_anchor": true,
    "no_image_pixels_or_prohibited_payload_opened": true
  },
  "outputs": {
    "raw_metadata_directory": "data/raw/sigma_v19am_nsc_sia_anchor_coverage",
    "manifest": "data/derived/sigma_v19am_nsc_sia_anchor_coverage/exposure_cutout_manifest.csv",
    "report": "results/sigma_v19am_nsc_sia_anchor_coverage/report.json"
  },
  "claim_boundary": [
    "A pass proves metadata-level image addressability for the fifteen already-open anchors only; it does not prove that every cutout URL downloads successfully or that the pixels support unbiased profile photometry.",
    "The 0.01-degree SIA footprint is used only to obtain the exact detector extension and access descriptor. V19AM does not freeze the later science-cutout footprint or any PSF/deblending model.",
    "Every measurement descriptor is retained. No exposure, band, object or validation row is ranked, rejected or selected using image quality or photometric performance.",
    "This is source-data feasibility evidence, not a stellar-mass, mass-current, lensing, halo or gravity result."
  ],
  "authorization": {
    "query_sia_metadata_for_exact_fifteen_anchor_coordinates": true,
    "persist_raw_metadata_and_exact_measurement_descriptors": true,
    "download_image_pixels": false,
    "rank_or_select_exposures": false,
    "inspect_image_pixels": false,
    "query_ambiguous_candidates": false,
    "infer_photometry_mass_or_current": false,
    "read_lensing_or_halo_payload": false,
    "change_gravity_physics_or_parameters": false,
    "open_holdout": false
  },
  "integrity": {
    "informal_metadata_preflight_run_before_freeze": true,
    "preflight_result_used_only_to_establish_service_feasibility_and_expected_row_count": true,
    "image_pixels_downloaded_at_freeze": false,
    "ambiguous_candidates_lensing_halo_or_gravity_payload_opened_at_freeze": false
  },
