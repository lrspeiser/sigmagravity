  "gti_protocol": {
    "step_1": "Intersect every parent GTI row with the closed branch interval and discard zero-width intersections.",
    "step_2": "Construct the observation source-environment GTI from the EHK expression T_SAA_SXS>0 && DYE_ELV>5 && CORTIME>6.",
    "step_3": "Intersect steps 1 and 2 and use that exact final GTI for the event file, source spectrum, grade-weight event, rslnxbgen input, and xaexpmap.",
    "required_header_updates": ["TSTART", "TSTOP", "EXPOSURE", "ONTIME"],
    "conditional_header_updates": ["Update LIVETIME using the preserved DEADC only when both keywords already exist; do not invent missing dead-time metadata."],
    "exposure_definition": "sum(STOP-START) over the final GTI",
    "forbidden": "Do not use the copied broad parent GTI or infer exposure from the first and last event times."
  },
  "event_selections": {
    "source_hp": "ITYPE==0 && (RISE_TIME+0.00075*DERIV_MAX)>46 && (RISE_TIME+0.00075*DERIV_MAX)<58 && STATUS[4]==b0 && PIXEL!=27",
    "rmf_grade_weight": "ITYPE<4 && (PI>=6000) && (PI<=20000) && (RISE_TIME+0.00075*DERIV_MAX)>46 && (RISE_TIME+0.00075*DERIV_MAX)<58 && STATUS[4]==b0 && PIXEL!=27",
    "nxb_event_expression": "(PI>=600) && ((RISE_TIME+0.00075*DERIV_MAX)>46) && ((RISE_TIME+0.00075*DERIV_MAX)<58) && (ITYPE==0) && (STATUS[4]==b0) && (PIXEL!=27)",
    "spectrum_energy_filter": "none during extraction; ignore outside the frozen fit band in XSPEC",
    "source_channels_per_keV": 2000
  },
