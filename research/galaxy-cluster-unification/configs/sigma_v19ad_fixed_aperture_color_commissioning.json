    "feature_scales": {"B_minus_R": 1.0, "R_minus_I": 0.5},
    "outputs": ["g_minus_r", "r_minus_i", "i_minus_z"],
    "fit": "independent affine regressions on the ten unchanged V19AB development IDs",
    "robust_residual_scale_mag": 0.15,
    "ridge_penalty": 0.25,
    "predictive_scale_floor_mag": 0.05,
    "maximum_function_evaluations": 5000
  },
  "validation_gates": {
    "maximum_validation_median_absolute_error_each_color_mag": 0.25,
    "minimum_color_only_top1_retrievals_out_of_5": 3,
    "minimum_color_only_mean_reciprocal_rank": 0.65,
    "all_primary_rows_must_have_griz": true,
    "all_optimizers_must_succeed": true,
    "sensitivity_apertures_are_diagnostic_and_cannot_rescue_primary_failure": true
