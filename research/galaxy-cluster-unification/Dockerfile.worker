FROM node:22.18.0-bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY worker-requirements.txt ./worker-requirements.txt
RUN python3 -m venv /opt/sigma-worker \
    && /opt/sigma-worker/bin/pip install --no-cache-dir --requirement worker-requirements.txt

COPY hosted-simulator/package.json hosted-simulator/package-lock.json ./hosted-simulator/
RUN cd hosted-simulator && npm ci --omit=dev

COPY src ./src
COPY scripts/run_generic_field_job.py ./scripts/run_generic_field_job.py
COPY hosted-simulator ./hosted-simulator

RUN useradd --create-home --uid 10001 sigmaworker \
    && mkdir -p /var/lib/sigma \
    && chown -R sigmaworker:sigmaworker /var/lib/sigma

ENV HOST=0.0.0.0 \
    PORT=8787 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SIMULATOR_PYTHON=/opt/sigma-worker/bin/python \
    SIMULATOR_WORKER_STORE=/var/lib/sigma

USER sigmaworker
VOLUME ["/var/lib/sigma"]
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:8787/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "hosted-simulator/scripts/worker-server.mjs"]
